# Codex: global ignore rules สำหรับ monorepo และ artifacts ที่ห้าม commit
# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
.python-version

# Node / Frontend
node_modules/
.next/
dist/
coverage/
pnpm-store/
*.tsbuildinfo
package-lock.json

# Env / secrets
.env
.env.*
!.env.example

# Runtime data / logs
*.log
tmp/
temp/

# Docker overrides
docker-compose.override.yml

# AI/ML large assets (no binary weights in git)
*.onnx
*.pt
*.pth
*.ckpt
*.bin
*.tflite
datasets/
models/
# Allow placeholder files inside models/ dirs to preserve directory structure in git
!apps/backend/models/
!apps/backend/models/.gitkeep
!apps/backend/models/README.md
!apps/backend/models/buffalo_s/
!apps/backend/models/buffalo_s/.gitkeep

# Local tool state
.claude/
.cursor/

# Training datasets (large, sensitive — keep out of repo)
joggy_dataset/
/dataset/
*.zip
