# Joggy-PicX RQ Worker production image — shares deps with FastAPI image
# Author: Claude (Tech Lead) — Phase 5 production deploy, 2026-06-06
# Replaces Codex Phase 1 skeleton

FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# System deps: same as FastAPI image (ONNX + OpenCV runtime libs).
# Worker hits the AI pipeline so it needs ALL of these.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 libgl1 libglib2.0-0 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv==0.5.18

WORKDIR /app

# ── Dependency layer ─────────────────────────────────────────────────────────
COPY apps/backend/pyproject.toml apps/backend/pyproject.toml
COPY apps/backend/README.md apps/backend/README.md
COPY apps/backend/uv.loc[k] apps/backend/uv.lock* /tmp/_lock_check/

WORKDIR /app/apps/backend
RUN uv sync --no-dev --frozen 2>/dev/null || uv sync --no-dev

# ── App layer ────────────────────────────────────────────────────────────────
WORKDIR /app
COPY apps/backend /app/apps/backend

WORKDIR /app/apps/backend

RUN useradd --create-home --shell /bin/bash --uid 1000 joggy && \
    chown -R joggy:joggy /app
USER joggy

# RQ worker — listens on the "default" queue, processes one job at a time per
# process. Spawn more replicas via docker compose `--scale worker=N` if needed.
CMD ["uv", "run", "rq", "worker", "--with-scheduler", "default"]
