# Codex: Dockerfile skeleton สำหรับ Worker container (CPU-only base image)
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Codex: ใช้ uv สำหรับจัดการ dependencies ให้สอดคล้องกับ backend package
RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
COPY apps/backend/pyproject.toml apps/backend/pyproject.toml

# Codex: sync production dependencies ของ worker side
RUN uv sync --frozen --package joggy-backend --no-dev || uv sync --package joggy-backend --no-dev

COPY apps/backend apps/backend

# Codex: placeholder command จนกว่า RQ worker entrypoint จะ implement ใน Phase 2
CMD ["uv", "run", "--package", "joggy-backend", "python", "-c", "print('joggy-worker skeleton ready')"]
