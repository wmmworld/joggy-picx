# Cursor: Example env for frontend (do NOT commit secrets)
# Supabase (Auth + API) - no secrets here, only example keys
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=pk_example_anonymous_key

# Cloudflare R2 public base (used for image URLs) - do not include access keys here
NEXT_PUBLIC_R2_BASE=https://<account>.r2.cloudflarestorage.com/<bucket>

# Internal API base (FastAPI backend on Hetzner) - default: localhost:8000 for local dev
NEXT_PUBLIC_API_URL=http://localhost:8000

# Feature flags / runtime
NEXT_PUBLIC_FEATURE_INTERNAL_DASHBOARD=true
