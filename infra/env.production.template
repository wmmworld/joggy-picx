# Joggy-PicX production secrets template
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this template:
#      cp infra/env.production.template .env.production
# 2. Fill in real values (NEVER commit .env.production)
# 3. Verify perms:
#      chmod 600 .env.production
#      sudo chown joggy:joggy .env.production
# 4. docker-compose.prod.yml expects this file at REPO_ROOT/.env.production
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be >= 32 chars; production rejects "change-me-in-production" (see config.py).
SECRET_KEY=__GENERATE_64_HEX_CHARS__

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API → Project URL
SUPABASE_URL=https://__YOUR_PROJECT__.supabase.co
# Project Settings → API → Project API keys (anon = client, service_role = server)
SUPABASE_ANON_KEY=__ANON_JWT__
SUPABASE_SERVICE_ROLE_KEY=__SERVICE_ROLE_JWT__
# Project Settings → API → JWT Settings → JWT Secret (HS256)
SUPABASE_JWT_SECRET=__JWT_SHARED_SECRET__
# Project Settings → Database → Connection string
# IMPORTANT: use ASYNCPG driver + transaction-mode pooler (port 5432)
DATABASE_URL=postgresql+asyncpg://postgres.__REF__:__DB_PASSWORD__@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# R2 → Manage R2 API Tokens → Create API Token (Object Read & Write)
R2_ACCOUNT_ID=__R2_ACCOUNT_ID__
R2_ACCESS_KEY_ID=__R2_ACCESS_KEY__
R2_SECRET_ACCESS_KEY=__R2_SECRET__
R2_BUCKET_NAME=joggypicx
# https://<account>.r2.cloudflarestorage.com (private + signed URLs)
R2_PUBLIC_BASE_URL=https://__ACCOUNT_ID__.r2.cloudflarestorage.com

# ── Redis ─────────────────────────────────────────────────────────────────────
# Overridden by docker-compose.prod.yml — this is only the fallback.
REDIS_URL=redis://localhost:6379/0

# ── Watchtower notifications (optional) ──────────────────────────────────────
# Discord webhook / Slack incoming webhook / shoutrrr URL.
# Empty = no notifications.
WATCHTOWER_NOTIFICATION_URL=
