# Rename this file to `ssl-joggy.conf` AFTER certbot has generated certs.
# (See docs/production-deploy.md §SSL for the bootstrap dance.)

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name __YOUR_DOMAIN__;

  # ── TLS cert (Let's Encrypt) ───────────────────────────────────────────────
  ssl_certificate     /etc/letsencrypt/live/__YOUR_DOMAIN__/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/__YOUR_DOMAIN__/privkey.pem;

  # Mozilla "intermediate" config, generated 2026-06
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
  ssl_prefer_server_ciphers off;
  ssl_session_timeout 1d;
  ssl_session_cache shared:MozSSL:10m;
  ssl_session_tickets off;

  # HSTS (1 year, include subdomains) — enable AFTER you confirm HTTPS works.
  # Once set, browsers refuse to talk over HTTP for the duration. Bootstrap
  # without it then turn on.
  # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  # Body size — must match ingest /ingest/photos upload limit (25 MB + slack)
  client_max_body_size 30M;

  # ── App proxy ──────────────────────────────────────────────────────────────
  # `set` + variable in proxy_pass forces nginx to re-resolve `fastapi` on
  # every request through the resolver in default.conf — without this, nginx
  # caches the upstream IP at boot and breaks 502 when the fastapi container
  # is rebuilt (Docker assigns a new IP). Seen in production 2026-06-09.
  location / {
    set $upstream_fastapi http://fastapi:8000;
    proxy_pass $upstream_fastapi;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    proxy_connect_timeout 5s;
  }

  # Health probe (uncached) — same dynamic-resolve trick
  location = /healthz {
    set $upstream_fastapi_health http://fastapi:8000;
    access_log off;
    proxy_pass $upstream_fastapi_health;
  }
}
